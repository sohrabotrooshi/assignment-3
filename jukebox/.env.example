# AI Jukebox — local configuration. RENAME this file to ".env" and fill in
# real values. ".env" is gitignored; NEVER commit it. Credentials stay out of
# GitHub, archives, browser code, logs, and documentation.

# LLM endpoint for DJ scripts / lyrics (--llm). The URL and model are not
# secret; the KEY is. Leave KEY empty to use offline template scripts.
JUKEBOX_LLM_URL=https://your-llm-endpoint.example/v1/chat/completions
JUKEBOX_LLM_MODEL=your-model-name
JUKEBOX_LLM_KEY=your-api-key-here
